// Deploy this file as a separate Apps Script Web App bound to the Purchase Material Google Sheet.
// It intentionally has no Dana URL, Sheet ID, or shared options sheet.
const CONFIG = { purchaseSheet: 'PURCHASE DATA' };

function doGet(e) { return json_(route_(e && e.parameter ? e.parameter.action || 'bootstrap' : 'bootstrap', e && e.parameter ? e.parameter : {})); }
function doPost(e) { try { const body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); return json_(route_(body.action || 'bootstrap', body)); } catch (error) { return json_({ ok: false, error: 'Invalid request: ' + String(error.message || error) }); } }
function route_(action, payload) { try { if (action === 'bootstrap') return ok_(bootstrap_()); if (action === 'getLedger') return ok_(getLedger_(String(payload.supplier || ''))); if (action === 'getAllLedgers') return ok_(getAllLedgers_()); if (action === 'savePurchase') return ok_(savePurchase_(Number(payload.sheetRow), payload.values || {})); if (action === 'addOption') return ok_(addOption_(String(payload.kind || ''), String(payload.value || ''))); throw new Error('Unknown action: ' + action); } catch (error) { return { ok: false, error: String(error.message || error) }; } }
function spreadsheet_() { const ss = SpreadsheetApp.getActiveSpreadsheet(); if (!ss) throw new Error('Bind this script to the Purchase Material Google Sheet before deploying.'); return ss; }
function sheet_(name) { const sheet = spreadsheet_().getSheetByName(name); if (!sheet) throw new Error('Purchase Material is missing sheet: ' + name); return sheet; }
function bootstrap_() { const records = readPurchases_(); return { records: records, options: options_(records), summary: readSummary_(), dashboard: readDashboard_() }; }
function readPurchases_() { const values = sheet_(CONFIG.purchaseSheet).getRange(1, 1, Math.max(sheet_(CONFIG.purchaseSheet).getLastRow(), 1), 9).getValues(); return values.slice(1).map(function(row, index) { if (row.slice(0, 8).every(function(value) { return value === '' || value === null; })) return null; return { sheetRow: index + 2, values: { date: date_(row[0]), supplier: row[1], billNo: row[2], material: row[3], billAmount: row[4], withoutBillAmount: row[5], billPaid: row[6], withoutPaid: row[7], totalPaid: row[8] } }; }).filter(Boolean); }
function options_(records) { const saved = savedOptions_(); return { suppliers: unique_(records.map(function(record) { return record.values.supplier; }).concat(saved.suppliers)), materials: unique_(records.map(function(record) { return record.values.material; }).concat(saved.materials)) }; }
function readSummary_() { const sheet = sheet_('PURCHASE SUMMARY'); const values = sheet.getRange(1, 1, Math.max(sheet.getLastRow(), 7), 4).getValues(); const suppliers = values.slice(6).filter(function(row) { return String(row[0] || '').trim(); }).map(function(row) { return { supplier: String(row[0]), purchase: num_(row[1]), paid: num_(row[2]), outstanding: num_(row[3]) }; }); return { totalPurchase: num_(sheet.getRange('B3').getValue()), totalPaid: num_(sheet.getRange('D3').getValue()), totalOutstanding: num_(sheet.getRange('B4').getValue()), suppliers: suppliers }; }
function readDashboard_() { const sheet = sheet_('PURCHASE CHART DASHBOARD'); const summary = readSummary_(); return { totalPurchase: num_(sheet.getRange('A4').getValue()), totalPaid: num_(sheet.getRange('D4').getValue()), totalOutstanding: num_(sheet.getRange('G4').getValue()), suppliers: summary.suppliers }; }
function optionsSheet_() { const ss = spreadsheet_(); let sheet = ss.getSheetByName('MATERIAL APP OPTIONS'); if (!sheet) { sheet = ss.insertSheet('MATERIAL APP OPTIONS'); sheet.getRange(1, 1, 1, 2).setValues([['Supplier names', 'Materials']]); sheet.hideSheet(); } return sheet; }
function optionColumn_(kind) { return kind === 'supplier' ? 1 : kind === 'material' ? 2 : 0; }
function savedOptions_() { const sheet = spreadsheet_().getSheetByName('MATERIAL APP OPTIONS'); if (!sheet || sheet.getLastRow() < 2) return { suppliers: [], materials: [] }; const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2).getValues(); return { suppliers: values.map(function(row) { return row[0]; }), materials: values.map(function(row) { return row[1]; }) }; }
function addOption_(kind, value) { const clean = String(value || '').trim(); if (!clean) throw new Error('Option value is required.'); if (!optionColumn_(kind)) throw new Error('Unsupported Purchase Material option.'); ensureOption_(kind, clean); return { value: clean }; }
function ensureOption_(kind, value) { const clean = String(value || '').trim(); const column = optionColumn_(kind); if (!clean || !column) return; const options = optionsSheet_(); const saved = options.getRange(2, column, Math.max(options.getLastRow() - 1, 1), 1).getValues().map(function(row) { return String(row[0] || '').trim().toLowerCase(); }); if (saved.indexOf(clean.toLowerCase()) < 0) options.getRange(options.getLastRow() + 1, column).setValue(clean); refreshValidation_(kind); }
function refreshValidation_(kind) { const dataColumn = kind === 'supplier' ? 2 : kind === 'material' ? 4 : 0; const optionColumn = optionColumn_(kind); if (!dataColumn || !optionColumn) throw new Error('Unsupported Purchase Material option.'); const data = sheet_(CONFIG.purchaseSheet); const options = optionsSheet_(); const existing = data.getRange(2, dataColumn, Math.max(data.getLastRow() - 1, 1), 1).getValues().map(function(row) { return String(row[0] || '').trim(); }).filter(Boolean); const saved = options.getRange(2, optionColumn, Math.max(options.getLastRow() - 1, 1), 1).getValues().map(function(row) { return String(row[0] || '').trim().toLowerCase(); }); existing.forEach(function(value) { if (saved.indexOf(value.toLowerCase()) < 0) { options.getRange(options.getLastRow() + 1, optionColumn).setValue(value); saved.push(value.toLowerCase()); } }); const source = options.getRange(2, optionColumn, Math.max(options.getLastRow() - 1, 1), 1); const rule = SpreadsheetApp.newDataValidation().requireValueInRange(source, true).setAllowInvalid(false).build(); data.getRange(2, dataColumn, Math.max(data.getMaxRows() - 1, 1), 1).setDataValidation(rule); if (kind === 'supplier') sheet_('PARTY LEDGER').getRange('B2').setDataValidation(rule); }
function nextRow_(sheet) { const last = Math.max(sheet.getLastRow(), 2); const values = sheet.getRange(2, 1, last - 1, 9).getDisplayValues(); for (var index = 0; index < values.length; index++) { if (values[index].every(function(value) { return String(value || '').trim() === ''; })) return index + 2; } return last + 1; }
function savePurchase_(sheetRow, values) { const date = parseDate_(values.date); const supplier = String(values.supplier || '').trim(); if (!date) throw new Error('Date is required.'); if (!supplier) throw new Error('Supplier name is required.'); const sheet = sheet_(CONFIG.purchaseSheet); const row = sheetRow && sheetRow >= 2 ? sheetRow : nextRow_(sheet); const write = { date: date, supplier: supplier, billNo: values.billNo || '', material: String(values.material || '').trim(), billAmount: blank_(values.billAmount), withoutBillAmount: blank_(values.withoutBillAmount), billPaid: blank_(values.billPaid), withoutPaid: blank_(values.withoutPaid) }; ensureOption_('supplier', write.supplier); if (write.material) ensureOption_('material', write.material); sheet.getRange(row, 1, 1, 8).setValues([[write.date, write.supplier, write.billNo, write.material, write.billAmount, write.withoutBillAmount, write.billPaid, write.withoutPaid]]); sheet.getRange(row, 9).setFormula('=IF(COUNTA(A' + row + ':H' + row + ')=0,"",SUM(G' + row + ':H' + row + '))'); SpreadsheetApp.flush(); return { sheetRow: row, message: sheetRow && sheetRow >= 2 ? 'Material purchase updated.' : 'Material purchase added.' }; }
function ledgerRows_(supplier) { const sheet = sheet_('PARTY LEDGER'); sheet.getRange('B2').setValue(supplier); SpreadsheetApp.flush(); const values = sheet.getRange(7, 1, Math.max(sheet.getLastRow() - 6, 1), 7).getValues(); return values.filter(function(row) { return row[0] !== '' && row[0] !== null; }).map(function(row) { return { date: date_(row[0]), billNo: row[1], billAmount: num_(row[2]), withoutBill: num_(row[3]), totalPurchase: num_(row[4]), totalPaid: num_(row[5]), runningOutstanding: num_(row[6]) }; }); }
function getLedger_(supplier) { if (!supplier) return []; const lock = LockService.getDocumentLock(); lock.waitLock(30000); try { return ledgerRows_(supplier); } finally { lock.releaseLock(); } }
function getAllLedgers_() { const suppliers = options_(readPurchases_()).suppliers; const lock = LockService.getDocumentLock(); lock.waitLock(30000); const ledger = sheet_('PARTY LEDGER'); const previousSupplier = ledger.getRange('B2').getValue(); try { return suppliers.map(function(supplier) { return { supplier: supplier, rows: ledgerRows_(supplier) }; }).filter(function(group) { return group.rows.length; }); } finally { ledger.getRange('B2').setValue(previousSupplier); SpreadsheetApp.flush(); lock.releaseLock(); } }
function unique_(values) { return values.map(function(value) { return String(value || '').trim(); }).filter(function(value, index, list) { return value && list.indexOf(value) === index; }).sort(); }
function num_(value) { return Number(value || 0); }
function blank_(value) { return value === '' || value === null || value === undefined ? '' : Number(value); }
function date_(value) { return value instanceof Date ? Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd') : value; }
function parseDate_(value) { if (!value) return ''; if (value instanceof Date) return value; const parts = String(value).split('-').map(Number); return parts.length === 3 && parts.every(function(part) { return !isNaN(part); }) ? new Date(Date.UTC(parts[0], parts[1] - 1, parts[2], 12, 0, 0)) : value; }
function json_(value) { return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON); }
function ok_(data) { return { ok: true, data: data }; }
