// Dana-only Apps Script. Deploy this file from the Purchase Dana Google Sheet.
const CONFIG = { purchaseSheet: 'PURCHASE DATA', spreadsheetId: '' };

function doGet(e) { return json_(route_(e && e.parameter ? e.parameter.action || 'bootstrap' : 'bootstrap', e && e.parameter ? e.parameter : {})); }
function doPost(e) { try { const body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); return json_(route_(body.action || 'bootstrap', body)); } catch (error) { return json_({ ok: false, error: 'Invalid request: ' + String(error.message || error) }); } }
function spreadsheet_() { if (CONFIG.spreadsheetId) return SpreadsheetApp.openById(CONFIG.spreadsheetId); const active = SpreadsheetApp.getActiveSpreadsheet(); if (!active) throw new Error('No Google Sheet is connected. Bind this Apps Script to the spreadsheet, or set CONFIG.spreadsheetId to the Google Sheet ID.'); return active; }
function route_(action, payload) { try { if (action === 'bootstrap') return ok_(bootstrap_()); if (action === 'getLedger') return ok_(getLedger_(String(payload.party || ''))); if (action === 'savePurchase') return ok_(savePurchase_(Number(payload.sheetRow), payload.values || {})); if (action === 'addOption') return ok_(addOption_(String(payload.kind || ''), String(payload.value || ''))); throw new Error('Unknown Dana action: ' + action); } catch (error) { return { ok: false, error: String(error.message || error) }; } }
function bootstrap_() { const rows = readPurchases_(); const options = options_(rows); return { records: rows, options: options, summary: summary_(rows), dashboard: dashboard_(rows) }; }
function readPurchases_() { const sheet = spreadsheet_().getSheetByName(CONFIG.purchaseSheet); if (!sheet) throw new Error('Missing sheet: ' + CONFIG.purchaseSheet); const values = sheet.getRange(1, 1, Math.max(sheet.getLastRow(), 1), 16).getValues(); return values.slice(1).map(function(row, index) { if (row.slice(0, 14).every(function(value) { return value === '' || value === null; })) return null; return { sheetRow: index + 2, values: { date: date_(row[0]), party: row[1], billNo: row[2], material: row[3], quantity: row[4], billRate: row[5], billAmount: row[6], withoutBillRate: row[7], withoutBillAmount: row[8], billPaid: row[9], withoutPaid: row[10], paymentType: row[11], totalPaid: row[12], balance: row[13], notes: row[15] } }; }).filter(Boolean); }
function options_(rows) { const saved = savedOptions_(); return { parties: unique_(rows.map(function(r) { return r.values.party; }).concat(saved.parties)), materials: unique_(rows.map(function(r) { return r.values.material; }).concat(saved.materials)), paymentTypes: unique_(rows.map(function(r) { return r.values.paymentType; }).concat(saved.paymentTypes)) }; }
function summary_(rows) { const kpis = rows.reduce(function(a, r) { const v = r.values; a.quantity += num_(v.quantity); a.totalPurchase += num_(v.billAmount) + num_(v.withoutBillAmount); a.totalPaid += num_(v.totalPaid); a.balance += num_(v.balance); return a; }, { quantity: 0, totalPurchase: 0, totalPaid: 0, balance: 0 }); const byParty = {}; rows.forEach(function(r) { const v = r.values; const p = String(v.party || 'Unassigned'); byParty[p] = byParty[p] || { party: p, quantity: 0, totalPurchase: 0, pending: 0 }; byParty[p].quantity += num_(v.quantity); byParty[p].totalPurchase += num_(v.billAmount) + num_(v.withoutBillAmount); byParty[p].pending += num_(v.balance); }); return { kpis: kpis, suppliers: Object.keys(byParty).map(function(k) { return byParty[k]; }).sort(function(a, b) { return b.pending - a.pending; }) }; }
function dashboard_(rows) { const s = summary_(rows); return { supplierPurchase: s.suppliers.slice().sort(function(a, b) { return b.totalPurchase - a.totalPurchase; }).map(function(x) { return { party: x.party, amount: x.totalPurchase }; }), paymentSummary: { billPaid: rows.reduce(function(a, r) { return a + num_(r.values.billPaid); }, 0), withoutPaid: rows.reduce(function(a, r) { return a + num_(r.values.withoutPaid); }, 0) } }; }
function getLedger_(party) { return readPurchases_().filter(function(r) { return String(r.values.party || '') === party; }); }
function savePurchase_(sheetRow, values) { const date = parseDate_(values.date); const party = String(values.party || '').trim(); if (!date) throw new Error('Date is required.'); if (!party) throw new Error('Party name is required.'); const sheet = spreadsheet_().getSheetByName(CONFIG.purchaseSheet); if (!sheet) throw new Error('Missing sheet: ' + CONFIG.purchaseSheet); const row = sheetRow && sheetRow >= 2 ? sheetRow : nextPurchaseRow_(sheet); const write = { date: date, party: party, billNo: values.billNo || '', material: String(values.material || '').trim(), quantity: blank_(values.quantity), billRate: blank_(values.billRate), withoutBillRate: blank_(values.withoutBillRate), billPaid: blank_(values.billPaid), withoutPaid: blank_(values.withoutPaid), paymentType: String(values.paymentType || '').trim(), notes: values.notes || '' }; ensureOption_( 'party', write.party); if (write.material) ensureOption_('material', write.material); if (write.paymentType) ensureOption_('paymentType', write.paymentType); sheet.getRange(row, 1).setValue(write.date); sheet.getRange(row, 2).setValue(write.party); sheet.getRange(row, 3).setValue(write.billNo); sheet.getRange(row, 4).setValue(write.material); sheet.getRange(row, 5).setValue(write.quantity); sheet.getRange(row, 6).setValue(write.billRate); sheet.getRange(row, 8).setValue(write.withoutBillRate); sheet.getRange(row, 10).setValue(write.billPaid); sheet.getRange(row, 11).setValue(write.withoutPaid); sheet.getRange(row, 12).setValue(write.paymentType); sheet.getRange(row, 16).setValue(write.notes); formulas_(sheet, row); SpreadsheetApp.flush(); return { sheetRow: row, message: sheetRow && sheetRow >= 2 ? 'Purchase updated.' : 'Purchase added.' }; }
function nextPurchaseRow_(sheet) { const last = Math.max(sheet.getLastRow(), 2); const values = sheet.getRange(2, 1, last - 1, 16).getDisplayValues(); for (var i = 0; i < values.length; i++) { if (values[i].every(function(value) { return String(value || '').trim() === ''; })) return i + 2; } return last + 1; }
function formulas_(sheet, row) { sheet.getRange(row, 7).setFormula('=IF(OR(E' + row + '="",F' + row + '=""),"",E' + row + '*F' + row + ')'); sheet.getRange(row, 9).setFormula('=IF(OR(E' + row + '="",H' + row + '=""),"",E' + row + '*H' + row + ')'); sheet.getRange(row, 13).setFormula('=IF(AND(J' + row + '="",K' + row + '=""),"",SUM(J' + row + ':K' + row + '))'); sheet.getRange(row, 14).setFormula('=IF(AND(G' + row + '="",I' + row + '=""),"",SUM(G' + row + ',I' + row + ')-SUM(J' + row + ',K' + row + '))'); }
function addOption_(kind, value) { value = String(value || '').trim(); if (!value) throw new Error('Option value is required.'); if (!optionColumn_(kind)) throw new Error('Unsupported option type.'); ensureOption_(kind, value); return { value: value }; }
function ensureOption_(kind, value) { const clean = String(value || '').trim(); const col = optionColumn_(kind); if (!clean || !col) return; const options = optionsSheet_(); const values = options.getRange(2, col, Math.max(options.getLastRow() - 1, 1), 1).getValues().map(function(row) { return String(row[0] || '').trim().toLowerCase(); }); if (values.indexOf(clean.toLowerCase()) < 0) options.getRange(options.getLastRow() + 1, col).setValue(clean); refreshPurchaseValidation_(kind); }
function refreshPurchaseValidation_(kind) { const purchaseColumn = kind === 'party' ? 2 : kind === 'material' ? 4 : kind === 'paymentType' ? 12 : 0; const optionColumn = optionColumn_(kind); if (!purchaseColumn || !optionColumn) throw new Error('Unsupported option type.'); const purchase = spreadsheet_().getSheetByName(CONFIG.purchaseSheet); if (!purchase) throw new Error('Missing sheet: ' + CONFIG.purchaseSheet); const options = optionsSheet_(); const rowCount = Math.max(purchase.getLastRow() - 1, 1); const existing = purchase.getRange(2, purchaseColumn, rowCount, 1).getValues(); existing.forEach(function(row) { const item = String(row[0] || '').trim(); if (!item) return; const saved = options.getRange(2, optionColumn, Math.max(options.getLastRow() - 1, 1), 1).getValues().map(function(value) { return String(value[0] || '').trim().toLowerCase(); }); if (saved.indexOf(item.toLowerCase()) < 0) options.getRange(options.getLastRow() + 1, optionColumn).setValue(item); }); const source = options.getRange(2, optionColumn, Math.max(options.getLastRow() - 1, 1), 1); const rule = SpreadsheetApp.newDataValidation().requireValueInRange(source, true).setAllowInvalid(false).build(); purchase.getRange(2, purchaseColumn, Math.max(purchase.getMaxRows() - 1, 1), 1).setDataValidation(rule); }
function optionsSheet_() { const ss = spreadsheet_(); let sheet = ss.getSheetByName('APP OPTIONS'); if (!sheet) { sheet = ss.insertSheet('APP OPTIONS'); sheet.getRange(1, 1, 1, 3).setValues([['Party names', 'Materials', 'Payment types']]); sheet.hideSheet(); } return sheet; }
function optionColumn_(kind) { return kind === 'party' ? 1 : kind === 'material' ? 2 : kind === 'paymentType' ? 3 : 0; }
function savedOptions_() { const sheet = spreadsheet_().getSheetByName('APP OPTIONS'); if (!sheet || sheet.getLastRow() < 2) return { parties: [], materials: [], paymentTypes: [] }; const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 3).getValues(); return { parties: values.map(function(r) { return r[0]; }), materials: values.map(function(r) { return r[1]; }), paymentTypes: values.map(function(r) { return r[2]; }) }; }
function unique_(values) { return values.map(function(v) { return String(v || '').trim(); }).filter(function(v, i, a) { return v && a.indexOf(v) === i; }).sort(); }
function num_(value) { return Number(value || 0); }
function blank_(value) { return value === '' || value === null || value === undefined ? '' : Number(value); }
function date_(value) { return value instanceof Date ? Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd') : value; }
function parseDate_(value) { if (!value) return ''; if (value instanceof Date) return value; const parts = String(value).split('-').map(Number); return parts.length === 3 && parts.every(function(part) { return !isNaN(part); }) ? new Date(Date.UTC(parts[0], parts[1] - 1, parts[2], 12, 0, 0)) : value; }
function json_(value) { return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON); }
function ok_(data) { return { ok: true, data: data }; }
